<Window x:Class="Lantern.Desktop.RelatedAccountsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Related-account investigation" Width="1040" Height="660" WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}">
  <Grid Background="{DynamicResource PageBrush}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Follow an investigation lead" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Choose an IP, application ID or message ID already in this case. Local matches appear immediately. Search tenant adds available evidence using the original tenant and date range; shared infrastructure and common apps do not establish compromise." Style="{StaticResource Muted}" Margin="0,10,0,16"/></StackPanel>
    <ComboBox x:Name="Seeds" Grid.Row="1" DisplayMemberPath="Label" SelectionChanged="SeedChanged" IsTextSearchEnabled="True" AutomationProperties.Name="Related evidence lead"/>
    <WrapPanel Grid.Row="2" Margin="0,12,0,12"><Button x:Name="SearchButton" Content="Search tenant for this lead" Click="Search"/><Button x:Name="CancelButton" Content="Cancel search" Click="Cancel" IsEnabled="False"/></WrapPanel>
    <DataGrid x:Name="Accounts" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="AccountChanged" AutomationProperties.Name="Related accounts"><DataGrid.Columns><DataGridTextColumn Header="Account / address" Binding="{Binding Account}" Width="260"/><DataGridTextColumn Header="Records" Binding="{Binding Records}"/><DataGridTextColumn Header="Relationship (not a verdict)" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
    <TextBlock x:Name="Status" Grid.Row="4" Style="{StaticResource Muted}" Margin="0,12,0,12"/>
    <WrapPanel Grid.Row="5"><Button x:Name="InvestigateButton" Content="Investigate selected account / address" Click="Investigate" IsEnabled="False"/><Button Content="Return to findings" Click="Return"/></WrapPanel>
  </Grid></Grid>
</Window>
