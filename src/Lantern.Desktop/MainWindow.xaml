<Window x:Class="Lantern.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/Lantern.ico" Title="365Lantern — Investigation preview" Width="1280" Height="880" MinWidth="1040" MinHeight="720" FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource PageBrush}">
  <Grid Background="{DynamicResource PageBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="20,28">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="27" Height="37" Margin="0,0,10,0"><Canvas Width="48" Height="64"><Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="5" StrokeLineJoin="Round" Data="M 14,15 L 14,8 Q 14,3 20,3 L 28,3 Q 34,3 34,8 L 34,15 M 12,20 L 36,20 L 42,51 Q 43,58 36,59 L 12,59 Q 5,58 6,51 Z"/><Path Fill="{DynamicResource AccentBrush}" Data="M24,29 L31,43 L24,51 L17,43 Z"/></Canvas></Viewbox>
            <TextBlock Text="365Lantern" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="INVESTIGATION PREVIEW" FontSize="10" Margin="0,12,0,0" Style="{StaticResource Muted}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="Appearance" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
          <ComboBox x:Name="ThemePicker" SelectedIndex="0" SelectionChanged="ThemeChanged" AutomationProperties.Name="Appearance"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
          <TextBlock Text="Local session · No telemetry" FontSize="11" Margin="0,16,0,0" Style="{StaticResource Muted}"/>
        </StackPanel>
        <StackPanel>
          <Button Content="Connect tenant" Tag="Connect tenant" Style="{StaticResource Nav}" Click="Navigate"/>
          <Button Content="Investigate" Tag="Investigate" Style="{StaticResource Nav}" Click="Navigate"/>



          <Button Content="Findings" Tag="Findings" Style="{StaticResource Nav}" Click="Navigate"/>
          <Button Content="Response" Tag="Response" Style="{StaticResource Nav}" Click="Navigate"/>

        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,26">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="Tenant overview" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Illuminate suspicious activity. Keep the evidence in your hands." Style="{StaticResource Muted}" Margin="0,6,14,0"/></StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="SessionLabel" Text="Not connected" HorizontalAlignment="Right" FontWeight="SemiBold"/><Button x:Name="DisconnectButton" Content="Clear session" Margin="0,8,0,0" Click="Disconnect"/></StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border x:Name="ConnectionPanel" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Connect your tenant" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Use Microsoft’s PowerShell sign-in. No 365Lantern app registration is required. Graph and Exchange may each prompt for sign-in or consent; use the same administrator account." Style="{StaticResource Muted}" Margin="0,10,0,18"/>
              <Button Content="Look up tenant ID in browser…" Click="TenantLookup" HorizontalAlignment="Left" Margin="0,0,0,12"/>
              <TextBlock Text="Directory (tenant) ID"/><TextBox x:Name="TenantIdBox" Margin="0,6,0,14" AutomationProperties.Name="Directory tenant ID"/>
              <CheckBox x:Name="IncludeGrants" Content="Include application-grant inventory (requests optional Directory.Read.All consent)" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,14"/>
              <CheckBox x:Name="AdvancedAuthentication" Content="Advanced: use my own app registration" Checked="AuthenticationModeChanged" Unchecked="AuthenticationModeChanged" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,14"/>
              <StackPanel x:Name="ClientRegistrationPanel" Visibility="Collapsed"><TextBlock Text="Application (client) ID"/><TextBox x:Name="ClientIdBox" Margin="0,6,0,14" AutomationProperties.Name="Application client ID"/><TextBlock Text="Public client with localhost redirect; delegated AuditLog.Read.All, User.Read.All, Device.Read.All and Exchange.Manage permissions." Style="{StaticResource Muted}" Margin="0,0,0,14"/></StackPanel>
              <TextBlock Text="Requires PowerShell 7, Microsoft.Graph.Authentication 2.36.1+ and ExchangeOnlineManagement 3.7+. Graph uses a process-scoped session. Clear session closes the helper; browser/Windows sign-in state, consent grants and Microsoft audit records may remain." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
              <Button x:Name="ConnectButton" Content="Sign in with Microsoft" Click="Connect" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border x:Name="ResponsePanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Response actions are not enabled in this build" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="This first slice validates investigation and evidence handling. No password resets, session revocation, rule changes, or other tenant writes are implemented." Margin="0,12,0,0" Style="{StaticResource Muted}"/></StackPanel></Border>
          <StackPanel x:Name="InvestigationPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Account to investigate" Style="{StaticResource Muted}"/><TextBox x:Name="AccountBox" Margin="0,6,0,0" AutomationProperties.Name="Account to investigate" ToolTip="Enter the exact user principal name"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Time range" Style="{StaticResource Muted}"/><ComboBox x:Name="DaysPicker" SelectedIndex="1" Margin="0,6,0,0" AutomationProperties.Name="Time range"><ComboBoxItem Content="Last 1 day" Tag="1"/><ComboBoxItem Content="Last 7 days" Tag="7"/><ComboBoxItem Content="Last 30 days" Tag="30"/></ComboBox></StackPanel></Grid>
                <CheckBox x:Name="TenantWide" Content="Tenant-wide investigation (all directory accounts; up to 1,000 per run)" Checked="ScopeChanged" Unchecked="ScopeChanged" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,0"/><WrapPanel Margin="0,16,0,0"><Button x:Name="CollectButton" Content="Investigate account" IsEnabled="False" Click="Collect"/><Button x:Name="OfflineButton" Content="Offline Investigation" Click="ImportJson"/><Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="Cancel"/></WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
            <WrapPanel><Button x:Name="RelatedButton" Content="Related accounts…" Click="Related" IsEnabled="False" Margin="0,0,8,12"/><Button x:Name="ExportFindingsButton" Content="Export Findings…" IsEnabled="False" Click="ExportFindings" HorizontalAlignment="Left" Margin="0,0,0,12"/></WrapPanel>
            <TextBlock Text="ZIP includes JSON/CSV suspicious behavior, findings and timeline, raw evidence, summary and integrity hashes. Contains sensitive case data." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="SummaryLabel" Text="Ready when you are" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ScopeLabel" Text="Connect a tenant or start an offline investigation." Margin="0,8,0,0" Style="{StaticResource Muted}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"><StackPanel><TextBlock Text="Suspicious Behavior" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SuspiciousSummary" Text="Run an investigation to review suspicious indicators." Style="{StaticResource Muted}" Margin="0,6,0,14"/>
              <ListBox x:Name="FindingsList" MaxHeight="240" SelectionChanged="FindingSelected" AutomationProperties.Name="Suspicious behavior"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,7"><TextBlock><Run Text="{Binding Priority}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/><Run Text="  ·  "/><Run Text="{Binding Title}" FontWeight="SemiBold"/></TextBlock><TextBlock Text="{Binding Account}" FontSize="12" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Basis}" FontSize="12" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
              <TextBlock x:Name="FindingDetail" Margin="0,14,0,0" Style="{StaticResource Muted}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Account activity timeline" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Recorded activity and current configuration, ordered in UTC. Select a row for original evidence and exact message-ID links. Message delivery does not prove a link click or compromise." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="TimelineAccount" SelectionChanged="TimelineFilterChanged" AutomationProperties.Name="Timeline account" Margin="0,0,12,0"/>
                <ComboBox x:Name="TimelineCategory" Grid.Column="1" SelectedIndex="0" SelectionChanged="TimelineFilterChanged" AutomationProperties.Name="Timeline category"><ComboBoxItem Content="All activity"/><ComboBoxItem Content="Authentication"/><ComboBoxItem Content="Mail flow"/><ComboBoxItem Content="Audit"/><ComboBoxItem Content="Identity"/><ComboBoxItem Content="Snapshot"/></ComboBox>
              </Grid>
              <TextBlock x:Name="TimelineSummary" Style="{StaticResource Muted}" Margin="0,10,0,12"/>
              <DataGrid x:Name="TimelineEvents" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="360" SelectionChanged="TimelineSelected" AutomationProperties.Name="Account timeline">
                <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}"/><DataGridTextColumn Header="Account" Binding="{Binding Account}"/><DataGridTextColumn Header="Type" Binding="{Binding Category}"/><DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="350"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}"/><DataGridTextColumn Header="IP" Binding="{Binding IP}"/></DataGrid.Columns>
              </DataGrid>
            </StackPanel></Border>
            <Border x:Name="DiagnosticsPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
              <TextBlock Text="Sign-in diagnostics" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="DiagnosticsSummary" Margin="0,10,0,12"/>
              <TextBlock Text="Geography comes from the supplied sign-in records; VPNs and proxies can change reported locations. Non-success includes interruptions and denied attempts. Counts describe this evidence, not a known-good baseline." Style="{StaticResource Muted}"/>
              <ComboBox x:Name="DiagnosticView" SelectedIndex="0" SelectionChanged="DiagnosticViewChanged" Margin="0,12,0,8" AutomationProperties.Name="Diagnostic breakdown"><ComboBoxItem Content="IP addresses"/><ComboBoxItem Content="Countries / territories"/><ComboBoxItem Content="States / regions"/><ComboBoxItem Content="Applications"/></ComboBox>
              <DataGrid x:Name="DiagnosticGroups" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="200" SelectionChanged="DiagnosticGroupSelected" AutomationProperties.Name="Diagnostic groups">
                <DataGrid.Columns><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Events" Binding="{Binding Events}"/><DataGridTextColumn Header="Success" Binding="{Binding Successful}"/><DataGridTextColumn Header="Non-success" Binding="{Binding NonSuccess}"/><DataGridTextColumn Header="Unknown" Binding="{Binding Unknown}"/><DataGridTextColumn Header="First UTC" Binding="{Binding FirstUtc}"/><DataGridTextColumn Header="Last UTC" Binding="{Binding LastUtc}"/></DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="Select a group to inspect its events, then select an event to view the original evidence. Times are UTC." Margin="0,10,0,8" Style="{StaticResource Muted}"/>
              <DataGrid x:Name="DiagnosticEvents" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="220" SelectionChanged="DiagnosticEventSelected" AutomationProperties.Name="Diagnostic events">
                <DataGrid.Columns><DataGridTextColumn Header="UTC" Binding="{Binding Time}"/><DataGridTextColumn Header="Account" Binding="{Binding Account}"/><DataGridTextColumn Header="IP" Binding="{Binding IP}"/><DataGridTextColumn Header="Country" Binding="{Binding Country}"/><DataGridTextColumn Header="Result" Binding="{Binding Outcome}"/><DataGridTextColumn Header="Client" Binding="{Binding Client}"/><DataGridTextColumn Header="Application" Binding="{Binding Application}"/></DataGrid.Columns>
              </DataGrid>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Collection coverage" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="LimitsLabel" Style="{StaticResource Muted}" Margin="0,0,0,16"/><ItemsControl x:Name="CoverageList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Source}" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Records, StringFormat={}{0} records}" Style="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>

            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Account MFA registration and registered devices" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Current registration report, not proof MFA was enforced. Missing report entries are unknown. Registered devices are not necessarily devices used in these sign-ins. See collection coverage for failures." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
              <DataGrid x:Name="AccountDetails" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="300"><DataGrid.Columns><DataGridTextColumn Header="Account" Binding="{Binding Account}"/><DataGridTextColumn Header="Methods registered" Binding="{Binding Methods}"/><DataGridTextColumn Header="MFA registered" Binding="{Binding MfaRegistered}"/><DataGridTextColumn Header="Devices" Binding="{Binding Devices}"/><DataGridTextColumn Header="Device query" Binding="{Binding DeviceStatus}"/></DataGrid.Columns></DataGrid>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Persistence and delegated access" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Current Full Access, Send As, Send on Behalf and OAuth delegated grants. Select an entry for original evidence. These are access configurations, not proof of compromise; effective access, application-only grants and group expansion are not evaluated. Review coverage for denied or skipped queries." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
              <DataGrid x:Name="PersistenceList" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="300" SelectionChanged="PersistenceSelected" AutomationProperties.Name="Persistence snapshots"><DataGrid.Columns><DataGridTextColumn Header="Account" Binding="{Binding Account}"/><DataGridTextColumn Header="Source" Binding="{Binding Source}"/><DataGridTextColumn Header="Trustee / client object ID" Binding="{Binding Principal}"/><DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="280"/><DataGridTextColumn Header="State" Binding="{Binding State}"/></DataGrid.Columns></DataGrid>
            </StackPanel></Border>
            <Border x:Name="RawPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Raw evidence · memory only" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="RawEvidence" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="300" AutomationProperties.Name="Raw evidence"/></StackPanel></Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0"><TextBlock x:Name="StatusLabel" Text="No tenant changes. Findings stay in memory until you explicitly export." Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/></Border>
    </Grid>
  </Grid>
</Window>
