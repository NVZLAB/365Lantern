function Connect-MgGraph { param($TenantId,$Scopes,$ContextScope,[switch]$NoWelcome,[switch]$UseDeviceCode) if($ContextScope -ne 'Process' -or (@($Scopes) -join ',') -notin @('AuditLog.Read.All,User.Read.All,Device.Read.All','AuditLog.Read.All,User.Read.All,Device.Read.All,Directory.Read.All')) {throw 'Invalid auth options'}; if($UseDeviceCode){[Console]::WriteLine('To sign in, use a web browser to open https://microsoft.com/devicelogin and enter the code ABCD12345 to authenticate.');[Console]::Error.WriteLine('To sign in, use a web browser to open https://microsoft.com/devicelogin and enter the code ABCD12345 to authenticate.')}; if($TenantId -eq '33333333-3333-3333-3333-333333333333'){Start-Sleep -Seconds 30}; $script:tenant=$TenantId }
function Get-MgContext { [pscustomobject]@{TenantId=$script:tenant;Account='admin@example.com';ContextScope='Process';AuthType='Delegated'} }
function Invoke-MgGraphRequest { param($Method,$Uri,$OutputType) if($Method -ne 'GET') {throw 'Write attempted'}; @{value=@(@{id='synthetic';userPrincipalName='alex@example.com'});exchangeAttempts=$(if(Get-Command Get-LanternFakeAttempts -ErrorAction SilentlyContinue){Get-LanternFakeAttempts}else{0})} | ConvertTo-Json -Compress -Depth 5 }
function Disconnect-MgGraph { }
Export-ModuleMember -Function *
